#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Only VMs with the router role run minirouter. rcS writes the role.
if [ "$(cat /run/live.role 2>/dev/null)" != router ]; then
    exec sleep 2147483647
fi

exec /usr/bin/minirouter -v=false -logfile /var/log/minirouter.log
