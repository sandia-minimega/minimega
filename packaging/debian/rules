#!/usr/bin/make -f
#export DH_VERBOSE=1

DST = debian/minimega

%:
	dh $@

# Copy the license files that LICENSES/ links to, and drop the xterm.js development files.
execute_after_dh_install:
	cp -rL ../LICENSES $(DST)/usr/share/doc/minimega/
	rm -rf $(DST)/opt/minimega/web/xterm.js/.[!.]*

override_dh_installsystemd:
	dh_installsystemd --no-start
