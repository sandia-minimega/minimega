#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs udev /dev
mkdir /dev/pts
mount -n -t devpts -o gid=5,mode=620 none /dev/pts
# current Debian and Ubuntu ship udevd only as systemd-udevd
if command -v udevd >/dev/null; then
	udevd --daemon
else
	/lib/systemd/systemd-udevd --daemon
fi
# load drivers: trigger's default action, change, loads none
udevadm trigger --action=add
udevadm settle
chmod a+rx /
modprobe loop

# shellcheck disable=SC3045 # the init shell supports ulimit -n
ulimit -n 999999

ifconfig lo up
ifconfig eth0 up
dhclient -v eth0

mkdir /var/run/sshd
/usr/sbin/sshd

setsid sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1'
